{
  "schema": 1,
  "probes": [
    {
      "alias": "cpe:/a:apache:http_server",
      "name": "Apache mod_status Server Version",
      "source": "manual:apache-mod-status",
      "detect": [
        {
          "anchor": "apache",
          "channel": "hdr:server",
          "regex": "^[aA][pP][aA][cC][hH][eE]"
        }
      ],
      "extract": [
        {
          "anchor": "server version: apache/",
          "regex": "[sS][eE][rR][vV][eE][rR] [vV][eE][rR][sS][iI][oO][nN]: [aA][pP][aA][cC][hH][eE]/([0-9]+%.[0-9]+%.[0-9]+)"
        }
      ],
      "paths": [
        "/server-status"
      ]
    }
  ]
}
