{
  "alias": "cpe:/a:apache:tomcat",
  "name": "Tomcat Changelog Version",
  "source": "manual:tomcat-docs-changelog",
  "detect": [
    {
      "anchor": "apache-coyote",
      "channel": "hdr:server",
      "regex": "^[aA][pP][aA][cC][hH][eE]%-[cC][oO][yY][oO][tT][eE]"
    },
    {
      "anchor": "apache tomcat/5.5",
      "channel": "body",
      "regex": "[aA][pP][aA][cC][hH][eE] [tT][oO][mM][cC][aA][tT]/5%.5"
    }
  ],
  "extract": [
    {
      "anchor": "tomcat 5.5.",
      "regex": "[tT][oO][mM][cC][aA][tT] (5%.5%.[0-9][0-9]*)"
    }
  ],
  "paths": [
    "/tomcat-docs/changelog.html"
  ]
}
